    )

    foreach(feature ${DisabledFeatures})
        list(APPEND DisabledFeaturesParams "-no-feature-${feature}")
    endforeach()

    message(STATUS "Disabled features parameters: ${DisabledFeaturesParams}")

    list(APPEND EnabledFeatures
        gui
        widgets
        optimize-size
        #ltcg
    )

    foreach(feature ${EnabledFeatures})
        list(APPEND EnabledFeaturesParams "-${feature}")
    endforeach()
    message(STATUS "Enabled features parameters: ${EnabledFeaturesParams}")

    make_directory(${BUILD_DIR})
    message(STATUS "Configure Qt from ${QT_SRC_DIR}")
    execute_process(
        COMMAND ${QT_SRC_DIR}/configure.bat -disable-deprecated-up-to 0x060800 ${QT_PARAM_STATIC} ${QT_PARAM_RUNTIME} ${QT_PARAM_BUILD_TYPE} ${EnabledFeaturesParams} ${DisabledFeaturesParams} -prefix ${INSTALL_DIR}
        WORKING_DIRECTORY ${BUILD_DIR}
        COMMAND_ERROR_IS_FATAL ANY
    )

    message(STATUS "Build Qt from ${BUILD_DIR}")
    execute_process(
        COMMAND ${CMAKE_COMMAND} --build . --parallel
        WORKING_DIRECTORY ${BUILD_DIR}
        COMMAND_ERROR_IS_FATAL ANY
    )

    make_directory(${INSTALL_DIR})
    message(STATUS "Install Qt to ${INSTALL_DIR}")
    execute_process(
        COMMAND ${CMAKE_COMMAND} --install .
        WORKING_DIRECTORY ${BUILD_DIR}
        COMMAND_ERROR_IS_FATAL ANY
    )

    set(QT_INSTALL_DIR_${CONFIGURATION_TYPE} "${INSTALL_DIR}" CACHE STRING "Qt install directory")
endforeach()

