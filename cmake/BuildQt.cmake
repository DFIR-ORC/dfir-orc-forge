#
# Extract from CMAKE_BINARY_DIR the parent directory when running preset with visual studio
#
#   ${project}/out/build/windows-debug => ${project}/out/build
#
# This allows to reuse the same archive and source for both target configuration
#
string(REGEX MATCH "(.*\\/out\\/build\\/)windows-.*" MATCHED "${CMAKE_BINARY_DIR}")
if (MATCHED)
    string(REGEX REPLACE "(.*\\/out\\/build).*" "\\1" BINARY_DIR "${MATCHED}")
else()
    set(BINARY_DIR ${CMAKE_BINARY_DIR})
endif()

set(QT_ARCHIVE_FILENAME "qtbase-everywhere-src-6.8.3.zip")
set(QT_ARCHIVE "${BINARY_DIR}/${QT_ARCHIVE_FILENAME}")
set(QT_URL "https://download.qt.io/official_releases/qt/6.8/6.8.3/submodules/qtbase-everywhere-src-6.8.3.zip")

string(REGEX REPLACE "\\.zip$" "" QT_BASENAME ${QT_ARCHIVE_FILENAME})
set(QT_SRC_DIR "${BINARY_DIR}/${QT_BASENAME}")
set(QT_ARCHIVE_SHA256 992BF7766E214A341EF793EB3665FB784787D2FD666955F5F507F4C6F1F770DD)

if (ENABLE_STATIC_QT)
    # Not supported at link with Qt debug build
    set(QT_PARAM_STATIC "-static")
else()
    set(QT_PARAM_STATIC "-shared")
endif()

if (ENABLE_STATIC_RUNTIME)
    # Not supported at link with debug build
    set(QT_PARAM_RUNTIME "-static-runtime")
    set(QT_RUNTIME_ID "-mt")
else()
    set(QT_RUNTIME_ID "-md")
endif()

if (DEFINED CMAKE_BUILD_TYPE)
    set(CMAKE_CONFIGURATION_TYPES ${CMAKE_BUILD_TYPE})
else()
    set(CMAKE_CONFIGURATION_TYPES "Debug;MinSizeRel")
endif()

foreach(CONFIGURATION_TYPE ${CMAKE_CONFIGURATION_TYPES})
    if(DEFINED QT_INSTALL_DIR_${CONFIGURATION_TYPE})
        message(STATUS "Skipping build as variable already defined QT_INSTALL_DIR_${CONFIGURATION_TYPE}")
        continue()
    endif()

    if (CONFIGURATION_TYPE STREQUAL "Debug")
        string(TOLOWER "-debug" QT_PARAM_BUILD_TYPE)
    else()
        string(TOLOWER "-release" QT_PARAM_BUILD_TYPE)
    endif()

    set(BUILD_DIR "${BINARY_DIR}/qtbase-build${QT_PARAM_BUILD_TYPE}${QT_PARAM_STATIC}${QT_RUNTIME_ID}")
    set(INSTALL_DIR "${BINARY_DIR}/qtbase-install${QT_PARAM_BUILD_TYPE}${QT_PARAM_STATIC}${QT_RUNTIME_ID}")

    if (EXISTS ${INSTALL_DIR})
        message(STATUS "Directory ${INSTALL_DIR} already exists. Skipping Qt build.")
        continue()
    endif()

    if(EXISTS ${QT_ARCHIVE})
        file(SHA256 ${QT_ARCHIVE} FILE_HASH)
        string(TOUPPER ${FILE_HASH} FILE_HASH)
        if(FILE_HASH STREQUAL QT_ARCHIVE_SHA256)
            message(STATUS "File ${QT_ARCHIVE} already exists and hash matches. Skipping download.")
        else()
            message(WARNING "File ${QT_ARCHIVE} exists but hash does not match. Redownloading...")
            file(REMOVE ${QT_ARCHIVE})
        endif()
    endif()

    if(NOT EXISTS ${QT_ARCHIVE})
        FILE(DOWNLOAD ${QT_URL} ${QT_ARCHIVE})
        file(SHA256 ${QT_ARCHIVE} FILE_HASH)
        string(TOUPPER ${FILE_HASH} FILE_HASH)
        if(NOT FILE_HASH STREQUAL QT_ARCHIVE_SHA256)
            message(FATAL_ERROR "File ${QT_ARCHIVE} hash does not match")
        endif()
    endif()

    if (NOT EXISTS ${QT_SRC_DIR})
        message(STATUS "Extract Qt to ${BINARY_DIR}")
        FILE(ARCHIVE_EXTRACT INPUT ${QT_ARCHIVE} DESTINATION ${BINARY_DIR})
    else()
        message(STATUS "Directory ${QT_SRC_DIR} already exists. Skipping extraction.")
    endif()

    #
    # Notes:
    # - raster-64bit: high dpi ?
    # - sessionmanager: allows applications to save and restore their state when a session is closed and restarted
