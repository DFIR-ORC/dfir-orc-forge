<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
    <xs:include schemaLocation="common.xsd" />

    <xs:simpleType name="RegInfoColumnsEnumType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="computername" />
            <xs:enumeration value="templatename" />
            <xs:enumeration value="searchterm" />
            <xs:enumeration value="lastmodificationdate" />
            <xs:enumeration value="keyname" />
            <xs:enumeration value="keytree" />
            <xs:enumeration value="valuename" />
            <xs:enumeration value="valuetype" />
            <xs:enumeration value="valuesize" />
            <xs:enumeration value="valueflag" />
            <xs:enumeration value="valuedata" />
            <xs:enumeration value="valuedumpfile" />
            <!-- aliases -->
            <xs:enumeration value="timeline" />
            <xs:enumeration value="all" />
            <xs:enumeration value="none" />
        </xs:restriction>
    </xs:simpleType>

    <!-- BEWARE: the values appears two time in following pattern -->
    <xs:simpleType name="RegInfoColumnsItemsType">
        <xs:restriction base="xs:string">
            <xs:pattern
                value="(computername|templatename|searchterm|lastmodificationdate|keyname|keytree|valuename|valuetype|valuesize|valueflag|valuedata|valuedumpfile|timeline|all|none)(,(computername|templatename|searchterm|lastmodificationdate|keyname|keytree|valuename|valuetype|valuesize|valueflag|valuedata|valuedumpfile|timeline|all|none))*" />
        </xs:restriction>
    </xs:simpleType>

    <xs:element name="reginfo">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="Log" type="LogType" minOccurs="0" maxOccurs="1" />
                <xs:element name="Output" type="OutputType" minOccurs="0" maxOccurs="1" />
                <xs:element name="Location" type="LocationType" minOccurs="0" maxOccurs="unbounded" />
                <xs:element name="Information" type="RegInfoColumnsItemsType" minOccurs="0"
                    maxOccurs="1" />
                <xs:element name="Hive" type="HiveType" minOccurs="0" maxOccurs="unbounded" />
                <xs:element name="KnownLocations" type="xs:string" minOccurs="0" maxOccurs="1" />
                <xs:element name="csv_limit" type="xs:nonNegativeInteger" minOccurs="0"
                    maxOccurs="1" />
            </xs:sequence>
            <xs:attribute name="Computer" type="ComputerNameType" use="optional" />
        </xs:complexType>
    </xs:element>

</xs:schema>
