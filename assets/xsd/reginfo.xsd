<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
    <xs:include schemaLocation="common.xsd" />

    <xs:simpleType name="RegInfoColumnsEnumType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="computername" />
            <xs:enumeration value="templatename" />
            <xs:enumeration value="searchterm" />
            <xs:enumeration value="lastmodificationdate" />
            <xs:enumeration value="keyname" />
            <xs:enumeration value="keytree" />
            <xs:enumeration value="valuename" />
            <xs:enumeration value="valuetype" />
            <xs:enumeration value="valuesize" />
            <xs:enumeration value="valueflag" />
            <xs:enumeration value="valuedata" />
            <xs:enumeration value="valuedumpfile" />
            <!-- aliases -->
            <xs:enumeration value="timeline" />
            <xs:enumeration value="all" />
            <xs:enumeration value="none" />
        </xs:restriction>
    </xs:simpleType>

    <!-- BEWARE: the values appears two time in following pattern -->
    <xs:simpleType name="RegInfoColumnsItemsType">
        <xs:restriction base="xs:string">
            <xs:pattern
                value="(computername|templatename|searchterm|lastmodificationdate|keyname|keytree|valuename|valuetype|valuesize|valueflag|valuedata|valuedumpfile|timeline|all|none)(,(computername|templatename|searchterm|lastmodificationdate|keyname|keytree|valuename|valuetype|valuesize|valueflag|valuedata|valuedumpfile|timeline|all|none))*" />
        </xs:restriction>
    </xs:simpleType>

    <xs:element name="reginfo">
        <xs:annotation><xs:documentation>Search and export registry data matching specified hive and key/value criteria from the specified locations.</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element name="Log" type="LogType" minOccurs="0" maxOccurs="1">
                    <xs:annotation><xs:documentation>Configure log output sinks (console, file) and their log levels.</xs:documentation></xs:annotation>
                </xs:element>
                <xs:element name="Output" type="OutputType" minOccurs="0" maxOccurs="1">
                    <xs:annotation><xs:documentation>Output file for registry search results (CSV).</xs:documentation></xs:annotation>
                </xs:element>
                <xs:element name="Location" type="LocationType" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation><xs:documentation>NTFS volume or path to search for registry hive files.</xs:documentation></xs:annotation>
                </xs:element>
                <xs:element name="Information" type="RegInfoColumnsItemsType" minOccurs="0" maxOccurs="1">
                    <xs:annotation><xs:documentation>Comma-separated list of output columns to include (e.g. keyname,valuename,valuedata).</xs:documentation></xs:annotation>
                </xs:element>
                <xs:element name="Hive" type="HiveType" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation><xs:documentation>Registry hive definition with location and search criteria (registry_find elements).</xs:documentation></xs:annotation>
                </xs:element>
                <xs:element name="KnownLocations" type="xs:string" minOccurs="0" maxOccurs="1">
                    <xs:annotation><xs:documentation>Include predefined system locations when searching for hive files.</xs:documentation></xs:annotation>
                </xs:element>
                <xs:element name="csv_limit" type="xs:nonNegativeInteger" minOccurs="0" maxOccurs="1">
                    <xs:annotation><xs:documentation>Maximum number of rows to write per output CSV file before starting a new file.</xs:documentation></xs:annotation>
                </xs:element>
            </xs:sequence>
            <xs:attribute name="Computer" type="ComputerNameType" use="optional">
                <xs:annotation><xs:documentation>Override the computer name written in the ComputerName column of the output file.</xs:documentation></xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>

</xs:schema>
