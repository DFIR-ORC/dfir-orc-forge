<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
    <xs:include schemaLocation="common.xsd" />

    <xs:element name="getthis">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="Log" type="LogType" minOccurs="0" maxOccurs="1" />
                <xs:element name="Output" type="OutputType" minOccurs="0" maxOccurs="1" />
                <xs:element name="Location" type="LocationType" minOccurs="0" maxOccurs="unbounded" />
                <xs:element name="KnownLocations" type="xs:string" minOccurs="0" maxOccurs="1" />
                <xs:element name="Yara" type="YaraType" minOccurs="0" />
                <xs:element name="Samples" type="GetThisSamplesType" />
            </xs:sequence>
            <xs:attribute name="NoLimits" type="EmptyType" use="optional" />
            <xs:attribute name="Resurrect" type="ResurrectType" use="optional" />
            <xs:attribute name="ReportAll" type="EmptyType" use="optional" />
            <xs:attribute name="FlushRegistry" type="YesNoType" use="optional" />
            <xs:attribute name="Hash" type="xs:string" use="optional" />
            <xs:attribute name="FuzzyZash" type="xs:string" use="optional" />
        </xs:complexType>
    </xs:element>

</xs:schema>
