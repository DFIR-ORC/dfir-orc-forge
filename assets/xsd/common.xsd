<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:ui="https://github.com/DFIR-ORC/dfir-orc/ui" elementFormDefault="qualified">

    <xs:simpleType name="YesNoType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="yes" />
            <xs:enumeration value="no" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="TrueFalseType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="true" />
            <xs:enumeration value="false" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="EnabledDisabledType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="enabled" />
            <xs:enumeration value="disabled" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="ByteQuantityType">
        <xs:restriction base="xs:string">
            <xs:pattern value="[0-9]+(k|m|g)?b?" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="ByteQuantityComparisonType">
        <xs:restriction base="xs:string">
            <xs:pattern value="(gt|lt|ge|le)?[0-9]+(k|m|g)?b?" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="TimeType">
        <xs:restriction base="xs:string">
          <xs:pattern value="[0-3][0-9]/[01][0-9]/[12][09][0-9][0-9] [0-2][0-9]:[0-5][0-9]"/>
        </xs:restriction>
      </xs:simpleType>

    <xs:simpleType name="Md5Type">
        <xs:restriction base="xs:string">
            <xs:pattern value="[0-9a-f]{32}" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="Sha1Type">
        <xs:restriction base="xs:string">
            <xs:pattern value="[0-9a-f]{40}" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="Sha256Type">
        <xs:restriction base="xs:string">
            <xs:pattern value="[0-9a-f]{64}" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="AbsolutePathWithoutDriveType">
        <xs:restriction base="xs:string">
            <xs:pattern value="(\\|\/).*" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="AbsolutePathType">
        <xs:restriction base="xs:string">
            <xs:pattern value="[a-z]:(\\|\/).*" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="PathType">
        <xs:restriction base="xs:string">
            <xs:pattern value=".*" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="HexStringType">
        <xs:restriction base="xs:string">
            <xs:pattern value="(0x)?([0-9a-f][0-9a-f])+" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="ResurrectType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="yes" />
            <xs:enumeration value="no" />
            <xs:enumeration value="resident" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="EmptyType">
        <xs:restriction base="xs:string">
            <xs:pattern value="" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="SampleContentType">
        <xs:restriction base="xs:string">
            <xs:pattern value="(data|raw|strings(\:min=\d+,max=\d+)?)" />
        </xs:restriction>
    </xs:simpleType>

    <!-- Filesystem element -->
    <xs:complexType name="FilesystemType">
        <xs:sequence>
            <xs:element name="Location" type="LocationType" minOccurs="1" maxOccurs="unbounded" />
            <xs:element name="Knownlocations" type="xs:string" minOccurs="0" maxOccurs="1" />
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element name="ntfs_find" type="NtfsFindType" />
                <xs:element name="ntfs_exclude" type="NtfsExcludeType" />
                <xs:element name="yara" type="YaraType" minOccurs="0" maxOccurs="unbounded" />
            </xs:choice>
        </xs:sequence>
        <xs:attribute name="Resurrect" type="ResurrectType" use="optional" default="no">
                <xs:annotation><xs:documentation>Include deleted entries: yes (all deleted), no (live only), or resident.</xs:documentation></xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:simpleType name="ShadowsType">
        <xs:restriction base="xs:string">
            <xs:pattern
                value="(yes|no|((newest|mid|oldest|{[0-9a-f]{8}-([0-9a-f]{4}-){3}[0-9a-f]{12}}),?)+)" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="AltitudeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="exact" />
            <xs:enumeration value="highest" />
            <xs:enumeration value="lowest" />
        </xs:restriction>
    </xs:simpleType>

    <!-- Location element -->
    <xs:complexType name="LocationType">
        <xs:annotation><xs:documentation>Access path to a volume. Use a drive letter (C:), volume ID, UNC path, physical drive path, disk image, or '*' for all mounted volumes. Environment variables and DFIR-ORC dynamic variables are supported.</xs:documentation></xs:annotation>
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="Shadows" type="ShadowsType" use="optional">
                    <xs:annotation><xs:documentation>Process volume shadow copies alongside the main volume. Values: yes, no, oldest, mid, newest, or a VSS shadow copy GUID. Multiple values can be combined.</xs:documentation></xs:annotation>
                </xs:attribute>
                <xs:attribute name="Altitude" type="AltitudeType" use="optional">
                    <xs:annotation><xs:documentation>Strategy for accessing the volume: exact (use the mounted volume as-is), highest (above filesystem filters), or lowest (below filters, closest to raw disk).</xs:documentation></xs:annotation>
                </xs:attribute>
                <xs:attribute name="Exclude" type="xs:string" use="optional">
                    <xs:annotation><xs:documentation>Comma-separated list of volumes to exclude from processing. Especially useful when the location value is the wildcard '*'. It is possible to exclude a drive while processing its shadow copies.</xs:documentation></xs:annotation>
                </xs:attribute>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <!-- Yara element -->
    <xs:complexType name="YaraType">
        <xs:annotation><xs:documentation>Configure YARA rule scanning. Specifies rule file(s) and scanning parameters used during file collection or search.</xs:documentation></xs:annotation>
        <xs:attribute name="source" type="xs:string" use="required">
            <xs:annotation><xs:documentation>Comma- or semicolon-separated list of YARA rule files. Can be file paths relative to the executable or embedded resource references (res:#ResourceName).</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="timeout" type="xs:integer" use="required">
            <xs:annotation><xs:documentation>Number of seconds after which the YARA engine aborts scanning a single file. Applies per-file individually.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="block" type="ByteQuantityType" use="optional">
            <xs:annotation><xs:documentation>Buffer size for block-based scanning (e.g. 2M, 4K). Should be at least the largest expected file size to avoid missing matches that span block boundaries.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="overlap" type="ByteQuantityType" use="optional">
            <xs:annotation><xs:documentation>Overlap between consecutive scan blocks to catch matches that straddle a block boundary (e.g. 4K, 8192).</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="scan_method" type="xs:string" use="optional">
            <xs:annotation><xs:documentation>File scanning method. Supported values:
            - 'blocks' (recommended): uses YARA's streaming API, but due to limited
              module compatibility (e.g., PE module), it currently behaves similarly
              to whole-file mapping. 'block' and 'overlap' settings are ignored.
            - 'blocks_legacy': legacy chunked scanning; not fully compatible with all
              YARA modules.
            - 'filemapping': maps the entire file into memory; high memory usage and
              not recommended for live systems.</xs:documentation></xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:attributeGroup name="NtfsAttributeGroup">
        <xs:attribute name="name" type="xs:string" use="optional">
            <xs:annotation><xs:documentation>Exact file name to match (case-insensitive).</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="name_match" type="xs:string" use="optional">
            <xs:annotation><xs:documentation>Wildcard pattern for file name matching (case-insensitive, e.g. *.dll).</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="name_regex" type="xs:string" use="optional">
            <xs:annotation><xs:documentation>Regular expression for file name matching.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="path" type="AbsolutePathWithoutDriveType" use="optional">
            <xs:annotation><xs:documentation>Absolute path without drive letter for exact path matching (e.g. \Windows\System32\cmd.exe).</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="path_match" type="xs:string" use="optional">
            <xs:annotation><xs:documentation>Wildcard pattern for full path matching.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="path_regex" type="xs:string" use="optional">
            <xs:annotation><xs:documentation>Regular expression for full path matching.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="size" type="ByteQuantityType" use="optional">
            <xs:annotation><xs:documentation>Exact file size to match (e.g. 1024, 4KB).</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="size_gt" type="ByteQuantityType" use="optional">
            <xs:annotation><xs:documentation>Match files strictly larger than this size (e.g. 1MB).</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="size_ge" type="ByteQuantityType" use="optional">
            <xs:annotation><xs:documentation>Match files of this size or larger (e.g. 1MB).</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="size_lt" type="ByteQuantityType" use="optional">
            <xs:annotation><xs:documentation>Match files strictly smaller than this size (e.g. 1MB).</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="size_le" type="ByteQuantityType" use="optional">
            <xs:annotation><xs:documentation>Match files of this size or smaller (e.g. 1MB).</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="ads" type="xs:string" use="optional">
            <xs:annotation><xs:documentation>Exact name of an NTFS alternate data stream to match.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="ads_match" type="xs:string" use="optional">
            <xs:annotation><xs:documentation>Wildcard pattern for alternate data stream name matching.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="ads_regex" type="xs:string" use="optional">
            <xs:annotation><xs:documentation>Regular expression for alternate data stream name matching.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="md5" type="Md5Type" use="optional">
            <xs:annotation><xs:documentation>MD5 hash (32 hex chars) that the file content must match.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="sha1" type="Sha1Type" use="optional">
            <xs:annotation><xs:documentation>SHA-1 hash (40 hex chars) that the file content must match.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="sha256" type="Sha256Type" use="optional">
            <xs:annotation><xs:documentation>SHA-256 hash (64 hex chars) that the file content must match.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="header" use="optional">
            <xs:annotation><xs:documentation>ASCII string (up to 128 chars) that must appear at the start of the file content.</xs:documentation></xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:string">
                    <xs:minLength value="1" />
                    <xs:maxLength value="128" />
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="header_hex">
            <xs:annotation><xs:documentation>Hex string (up to 256 chars) representing bytes that must appear at the start of the file.</xs:documentation></xs:annotation>
            <xs:simpleType>
                <xs:restriction base="HexStringType">
                    <xs:maxLength value="256" />
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="header_regex" type="xs:string" use="optional">
            <xs:annotation><xs:documentation>Regular expression matched against the file header bytes.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="header_length" type="xs:integer" use="optional">
            <xs:annotation><xs:documentation>Number of bytes to read from the file header for matching (default is determined by the header/header_hex/header_regex value length).</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="contains" type="xs:string" use="optional">
            <xs:annotation><xs:documentation>ASCII string that must appear anywhere in the file content.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="contains_hex" type="HexStringType" use="optional">
            <xs:annotation><xs:documentation>Hex-encoded byte sequence that must appear anywhere in the file content.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="yara_rule" type="xs:string" use="optional">
            <xs:annotation><xs:documentation>Name of a YARA rule (from the configured yara element) that must match the file content.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="attr_name" type="xs:string" use="optional">
            <xs:annotation><xs:documentation>Exact NTFS attribute name to match.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="attr_match" type="xs:string" use="optional">
            <xs:annotation><xs:documentation>Wildcard pattern for NTFS attribute name matching.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="attr_regex" type="xs:string" use="optional">
            <xs:annotation><xs:documentation>Regular expression for NTFS attribute name matching.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="attr_type" type="xs:string" use="optional">
            <xs:annotation><xs:documentation>NTFS attribute type code to match (e.g. $DATA, $FILE_NAME).</xs:documentation></xs:annotation>
        </xs:attribute>
    </xs:attributeGroup>

    <!-- NtfsFind element -->
    <xs:complexType name="NtfsFindType" ui:attributes="list">
        <xs:annotation><xs:documentation>NTFS file/attribute search criteria. All specified attributes are AND-ed. Matches are collected or reported. Combine with ntfs_exclude to filter out unwanted results.</xs:documentation></xs:annotation>
        <xs:attributeGroup ref="NtfsAttributeGroup" />
        <xs:attribute name="ea" type="xs:string" use="optional">
            <xs:annotation><xs:documentation>Exact extended attribute name to match.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="ea_match" type="xs:string" use="optional">
            <xs:annotation><xs:documentation>Wildcard pattern for extended attribute name matching.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="ea_regex" type="xs:string" use="optional">
            <xs:annotation><xs:documentation>Regular expression for extended attribute name matching.</xs:documentation></xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <!-- NtfsExclude element -->
    <xs:complexType name="NtfsExcludeType" ui:attributes="list">
        <xs:annotation><xs:documentation>NTFS exclusion criteria. Entries matching these attributes are excluded from collection even if they match an ntfs_find rule. Scope is the whole configuration file.</xs:documentation></xs:annotation>
        <xs:attributeGroup ref="NtfsAttributeGroup" />
    </xs:complexType>

    <!-- Registry element -->
    <xs:complexType name="RegistryType">
        <xs:sequence>
            <xs:element name="Location" type="LocationType" minOccurs="1" maxOccurs="unbounded" />
            <xs:element name="KnownLocations" type="xs:string" minOccurs="0" maxOccurs="1" />
            <xs:element name="Hive" type="HiveType" maxOccurs="unbounded" />
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="HiveTemplateType">
        <xs:attribute name="Name" type="xs:string" use="required" />
        <xs:attribute name="Location" type="xs:string" use="required" />
    </xs:complexType>

    <!-- Hive element -->
    <xs:complexType name="HiveType">
        <xs:sequence>
            <xs:element name="reginfo_template" type="HiveTemplateType" minOccurs="0" maxOccurs="1"/>
            <xs:element name="filename" type="AbsolutePathType" minOccurs="0" maxOccurs="1" />
            <xs:element name="ntfs_find" type="NtfsFindType" minOccurs="0" maxOccurs="1" />
            <xs:element name="registry_find" type="RegistryFindType" minOccurs="0" maxOccurs="unbounded" />
        </xs:sequence>
        <xs:attribute name="Name" type="xs:string" use="required" />
    </xs:complexType>

    <xs:simpleType name="RegistryValueType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="reg_none" />
            <xs:enumeration value="reg_sz" />
            <xs:enumeration value="reg_expand_sz" />
            <xs:enumeration value="reg_binary" />
            <xs:enumeration value="reg_dword" />
            <xs:enumeration value="reg_dword_little_endian" />
            <xs:enumeration value="reg_dword_big_endian" />
            <xs:enumeration value="reg_link" />
            <xs:enumeration value="reg_multi_sz" />
            <xs:enumeration value="reg_ressource_list" />
            <xs:enumeration value="reg_full_ressource_descriptior" />
            <xs:enumeration value="reg_resource_requirements_list" />
            <xs:enumeration value="reg_qword" />
            <xs:enumeration value="reg_qword_little_endian" />
        </xs:restriction>
    </xs:simpleType>

    <!-- RegistryFind element -->
    <xs:complexType name="RegistryFindType" ui:attributes="list">
        <xs:attribute name="key" type="xs:string" use="optional" />
        <xs:attribute name="key_regex" type="xs:string" use="optional" />
        <xs:attribute name="key_path" type="AbsolutePathWithoutDriveType" use="optional" />
        <xs:attribute name="key_path_regex" type="xs:string" use="optional" />
        <xs:attribute name="value" type="xs:string" use="optional" />
        <xs:attribute name="value_regex" type="xs:string" use="optional" />
        <xs:attribute name="value_type" type="RegistryValueType" use="optional" />
        <xs:attribute name="data" type="xs:string" use="optional" />
        <xs:attribute name="data_hex" type="HexStringType" use="optional" />
        <xs:attribute name="data_regex" type="xs:string" use="optional" />
        <xs:attribute name="data_size" type="ByteQuantityType" use="optional" />
        <xs:attribute name="data_size_gt" type="ByteQuantityType" use="optional" />
        <xs:attribute name="data_size_ge" type="ByteQuantityType" use="optional" />
        <xs:attribute name="data_size_lt" type="ByteQuantityType" use="optional" />
        <xs:attribute name="data_size_le" type="ByteQuantityType" use="optional" />
        <xs:attribute name="data_contains" type="xs:string" use="optional" />
        <xs:attribute name="data_contains_hex" type="HexStringType" use="optional" />
    </xs:complexType>

    <!-- Object element -->
    <xs:complexType name="ObjectType">
        <xs:sequence>
            <xs:element name="object_find" type="ObjectFindType" maxOccurs="unbounded" />
        </xs:sequence>
    </xs:complexType>

    <!-- ObjectFind element -->
    <xs:complexType name="ObjectFindType" ui:attributes="list">
        <xs:attribute name="type" type="xs:string" use="required" />
        <xs:attribute name="name" type="xs:string" use="required" />
        <xs:attribute name="name_match" type="xs:string" use="optional" />
        <xs:attribute name="name_regex" type="xs:string" use="optional" />
        <xs:attribute name="path" type="xs:string" use="optional" />
        <xs:attribute name="path_match" type="xs:string" use="optional" />
        <xs:attribute name="path_regex" type="xs:string" use="optional" />
    </xs:complexType>

    <xs:complexType name="LogConsoleType">
        <xs:attributeGroup ref="LogLevelAttributeGroup" />
    </xs:complexType>

    <xs:simpleType name="FormatType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="7z" />
            <xs:enumeration value=".7z" />
            <xs:enumeration value="zip" />
            <xs:enumeration value=".zip" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="DispositionType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="truncate" />
            <xs:enumeration value="append" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="CompressionType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="none" />
            <xs:enumeration value="fastest" />
            <xs:enumeration value="fast" />
            <xs:enumeration value="normal" />
            <xs:enumeration value="maximum" />
            <xs:enumeration value="ultra" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="EncodingType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="utf-8" />
            <xs:enumeration value="utf-16" />
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="OutputType">
        <xs:annotation><xs:documentation>Output destination for collected data: a file path, directory, or archive. Supports environment variables and DFIR-ORC pattern substitutions.</xs:documentation></xs:annotation>
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="Format" type="FormatType" use="optional">
                    <xs:annotation><xs:documentation>Archive format when the output path is an archive: 7z or zip.</xs:documentation></xs:annotation>
                </xs:attribute>
                <xs:attribute name="Compression" type="CompressionType" use="optional">
                    <xs:annotation><xs:documentation>Compression level for archive output: none, fastest, fast, normal, maximum, or ultra.</xs:documentation></xs:annotation>
                </xs:attribute>
                <xs:attribute name="Encoding" type="EncodingType" use="optional">
                    <xs:annotation><xs:documentation>Text encoding for CSV output files: utf-8 or utf-16.</xs:documentation></xs:annotation>
                </xs:attribute>
                <xs:attribute name="Disposition" type="DispositionType" use="optional">
                    <xs:annotation><xs:documentation>File handling when the output already exists: truncate (overwrite, default) or append.</xs:documentation></xs:annotation>
                </xs:attribute>
                <xs:attribute name="Password" type="xs:string" use="optional">
                    <xs:annotation><xs:documentation>Password for encrypted archive output. Preferred over XOR for protecting collected data from antivirus interference.</xs:documentation></xs:annotation>
                </xs:attribute>
                <xs:attribute name="ConnectionString" type="xs:string" use="optional">
                    <xs:annotation><xs:documentation>Database connection string for SQL output destinations.</xs:documentation></xs:annotation>
                </xs:attribute>
                <xs:attribute name="Key" type="xs:string" use="optional">
                    <xs:annotation><xs:documentation>Key column name for SQL/structured output.</xs:documentation></xs:annotation>
                </xs:attribute>
                <xs:attribute name="Table" type="xs:string" use="optional">
                    <xs:annotation><xs:documentation>Target table name for SQL output.</xs:documentation></xs:annotation>
                </xs:attribute>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <xs:complexType name="LogFileType">
        <xs:sequence>
            <xs:element name="Output" type="OutputType" minOccurs="1" maxOccurs="1" />
        </xs:sequence>
        <xs:attributeGroup ref="LogLevelAttributeGroup" />
    </xs:complexType>

    <xs:simpleType name="NetworkPortType">
        <xs:restriction base="xs:integer">
            <xs:minInclusive value="1" />
            <xs:maxInclusive value="65535" />
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="LogSyslogType">
        <xs:sequence>
            <xs:element name="Host" type="OutputType" minOccurs="1" maxOccurs="1" />
            <xs:element name="Port" type="NetworkPortType" minOccurs="0" maxOccurs="1" />
        </xs:sequence>
        <xs:attributeGroup ref="LogLevelAttributeGroup" />
    </xs:complexType>

    <xs:simpleType name="LogLevelType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="trace" />
            <xs:enumeration value="debug" />
            <xs:enumeration value="info" />
            <xs:enumeration value="warning" />
            <xs:enumeration value="error" />
            <xs:enumeration value="critical" />
            <xs:enumeration value="off" />
        </xs:restriction>
    </xs:simpleType>

    <xs:attributeGroup name="LogLevelAttributeGroup">
        <xs:attribute name="Level" type="LogLevelType" use="optional">
            <xs:annotation><xs:documentation>Minimum log level to emit: trace, debug, info, warning, error, critical, or off.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="Backtrace" type="LogLevelType" use="optional">
            <xs:annotation><xs:documentation>Log level that triggers emission of a debug backtrace (captures logs down to the 'debug' level). Use 'off' to disable.</xs:documentation></xs:annotation>
        </xs:attribute>
    </xs:attributeGroup>

    <xs:complexType name="LogType">
        <xs:sequence>
            <xs:element name="Console" type="LogConsoleType" minOccurs="0" maxOccurs="1" />
            <xs:element name="File" type="LogFileType" minOccurs="0" maxOccurs="1" />
        </xs:sequence>
        <xs:attributeGroup ref="LogLevelAttributeGroup" />
    </xs:complexType>

    <xs:complexType name="LogWithSyslogType">
        <xs:sequence>
            <xs:element name="Console" type="LogConsoleType" minOccurs="0" maxOccurs="1" />
            <xs:element name="File" type="LogFileType" minOccurs="0" maxOccurs="1" />
            <xs:element name="Syslog" type="LogSyslogType" minOccurs="0" maxOccurs="1" />
        </xs:sequence>
        <xs:attributeGroup ref="LogLevelAttributeGroup" />
    </xs:complexType>

    <xs:complexType name="ConsoleType">
        <xs:sequence>
            <xs:element name="Output" type="OutputType" minOccurs="1" maxOccurs="1" />
        </xs:sequence>
    </xs:complexType>

    <xs:simpleType name="PriorityClassType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="low" />
            <xs:enumeration value="high" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="PowerStateType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="systemrequired" />
            <xs:enumeration value="displayrequired" />
            <xs:enumeration value="userpresent" />
            <xs:enumeration value="awaymode" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="UploadMethodType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="bits" />
            <xs:enumeration value="filecopy" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="AuthSchemeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="anonymous" />
            <xs:enumeration value="basic" />
            <xs:enumeration value="ntlm" />
            <xs:enumeration value="kerberos" />
            <xs:enumeration value="negotiate" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="OperationType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="copy" />
            <xs:enumeration value="move" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="ModeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="sync" />
            <xs:enumeration value="async" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="UrlHostType">
        <xs:restriction base="xs:anyURI">
            <xs:pattern value="(https?|file)://[^/]+" />
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="RecipientType">
        <xs:annotation><xs:documentation>CMS/PKCS#7 certificate for archive encryption. The element text content is the DER-encoded certificate (base64). Multiple recipients can be specified.</xs:documentation></xs:annotation>
        <xs:simpleContent>
            <xs:extension base="xs:string">
              <xs:attribute name="Name" type="xs:string" use="required">
                  <xs:annotation><xs:documentation>Identifier for this recipient, used in log messages.</xs:documentation></xs:annotation>
              </xs:attribute>
              <xs:attribute name="Archive" type="xs:string" use="required">
                  <xs:annotation><xs:documentation>Name (or wildcard pattern) of the archive(s) this certificate applies to for encryption.</xs:documentation></xs:annotation>
              </xs:attribute>
            </xs:extension>
          </xs:simpleContent>
    </xs:complexType>

    <xs:simpleType name="KeyType">
        <xs:restriction base="xs:string" />
    </xs:simpleType>

    <xs:simpleType name="EnableKeyType">
        <xs:restriction base="xs:string" />
    </xs:simpleType>

    <xs:simpleType name="DisableKeyType">
        <xs:restriction base="xs:string" />
    </xs:simpleType>

    <xs:complexType name="UploadType">
        <xs:annotation><xs:documentation>Configure automatic upload of collected archives to a remote server after execution completes.</xs:documentation></xs:annotation>
        <xs:attribute name="Job" type="YesNoType" use="optional">
            <xs:annotation><xs:documentation>If yes, use Background Intelligent Transfer Service (BITS) job management for upload.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="Method" type="UploadMethodType" use="required">
            <xs:annotation><xs:documentation>Upload protocol: bits (BITS/HTTP) or filecopy (SMB file copy).</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="Server" type="UrlHostType" use="required">
            <xs:annotation><xs:documentation>Target server URL including scheme and host (e.g. https://server.example.com or file://\\server\share).</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="Path" use="required">
            <xs:annotation><xs:documentation>Server-side path where files will be uploaded. Must start with '/'.</xs:documentation></xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:string">
                    <xs:pattern value="/.*" />
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="User" type="xs:string" use="optional">
            <xs:annotation><xs:documentation>Username for authenticated upload.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="Password" type="xs:string" use="optional">
            <xs:annotation><xs:documentation>Password for authenticated upload.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="Authscheme" type="AuthSchemeType" use="optional">
            <xs:annotation><xs:documentation>HTTP authentication scheme: anonymous, basic, ntlm, kerberos, or negotiate.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="Operation" type="OperationType" use="optional">
            <xs:annotation><xs:documentation>File operation after successful upload: copy (leave source intact) or move (delete source after upload).</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="Mode" type="ModeType" use="optional">
            <xs:annotation><xs:documentation>Upload timing: sync (wait for upload to complete before proceeding) or async (upload in background).</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="Include" type="xs:string" use="optional">
            <xs:annotation><xs:documentation>Wildcard pattern for archive file names to include in the upload.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="Exclude" type="xs:string" use="optional">
            <xs:annotation><xs:documentation>Wildcard pattern for archive file names to exclude from the upload.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="delete_smb_share" type="TrueFalseType" use="optional">
            <xs:annotation><xs:documentation>If true, delete the SMB share after completing the filecopy upload.</xs:documentation></xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:simpleType name="ArchiveRepeatType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="createnew" />
            <xs:enumeration value="overwrite" />
            <xs:enumeration value="once" />
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="ArchiveRestrictionType">
        <xs:attribute name="Jobmemorylimit" type="ByteQuantityType" use="optional">
            <xs:annotation><xs:documentation>Maximum total memory for all processes in the job object (e.g. 2GB). Commands will not run if memory usage exceeds this limit.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="Processmemorylimit" type="ByteQuantityType" use="optional">
            <xs:annotation><xs:documentation>Maximum memory per individual process in the job (e.g. 512MB).</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="Elapsedtimelimit" type="xs:nonNegativeInteger" use="optional">
            <xs:annotation><xs:documentation>Maximum wall-clock time in seconds allowed for the entire job.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="Jobcpulimit" type="xs:nonNegativeInteger" use="optional">
            <xs:annotation><xs:documentation>CPU usage limit (percentage) for all processes in the job combined.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="Processcpulimit" type="xs:nonNegativeInteger" use="optional">
            <xs:annotation><xs:documentation>CPU usage limit (percentage) per individual process in the job.</xs:documentation></xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:simpleType name="WinVerType">
        <xs:restriction base="xs:string">
            <xs:pattern value="[0-9]+\.[0-9]+[+-]?" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="CommandQueueType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="flush" />
            <xs:enumeration value="anytime" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="SystemType">
        <xs:restriction base="xs:string">
            <xs:pattern
                value="(workstation|server|domaincontroller)(\|(workstation|server|domaincontroller))*" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="ComputerNameType">
        <xs:restriction base="xs:string">
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="FileExtensionType">
        <xs:restriction base="xs:string">
            <xs:pattern value="\.[a-zA-Z0-9]+(,\.[a-zA-Z0-9]+)*" />
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="CommandExecuteType">
        <xs:attribute name="Name" type="xs:string" use="required" />
        <xs:attribute name="Run" type="xs:string" use="optional" />
        <xs:attribute name="Run32" type="xs:string" use="optional" />
        <xs:attribute name="Run64" type="xs:string" use="optional" />
    </xs:complexType>

    <xs:complexType name="CommandInputType">
        <xs:attribute name="Name" type="xs:string" use="required" />
        <xs:attribute name="Source" type="xs:string" use="required" />
        <xs:attribute name="Argument" type="xs:string" use="optional" />
    </xs:complexType>

    <xs:simpleType name="CommandOutputSourceType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="stdout" />
            <xs:enumeration value="stderr" />
            <xs:enumeration value="stdouterr" />
            <xs:enumeration value="file" />
            <xs:enumeration value="directory" />
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="CommandOutputType">
        <xs:attribute name="Name" type="xs:string" use="required" />
        <xs:attribute name="Source" type="CommandOutputSourceType" use="required" />
        <xs:attribute name="Argument" type="xs:string" use="optional" />
        <xs:attribute name="FileMatch" type="xs:string" use="optional" />
    </xs:complexType>

    <xs:complexType name="ArchiveCommandType">
        <xs:sequence>
            <xs:element name="Execute" type="CommandExecuteType" minOccurs="1" />
            <xs:choice maxOccurs="unbounded">
                <xs:element name="Argument" type="xs:string" />
                <xs:element name="Input" type="CommandInputType" />
                <xs:element name="Output" type="CommandOutputType" />
            </xs:choice>
        </xs:sequence>
        <xs:attribute name="Keyword" type="xs:string" use="required">
            <xs:annotation><xs:documentation>Unique identifier for this command within the archive. Used for logging and dependency tracking.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="Timeout" type="xs:positiveInteger" use="optional">
            <xs:annotation><xs:documentation>Maximum execution time in seconds for this command before it is forcibly terminated.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="Winver" type="WinVerType" use="optional">
            <xs:annotation><xs:documentation>Minimum Windows version required to run this command (e.g. 6.1, 10.0+). Command is skipped on older systems.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="Queue" type="CommandQueueType" use="optional">
            <xs:annotation><xs:documentation>Execution queue mode: flush (wait for all previous commands to finish) or anytime (run when a slot is free).</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="SystemType" type="SystemType" use="optional">
            <xs:annotation><xs:documentation>Required system role to run this command: workstation, server, or domaincontroller. Multiple values can be combined with '|'.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="DiskFree" type="ByteQuantityType" use="optional">
            <xs:annotation><xs:documentation>Minimum free disk space required to run this command (e.g. 500MB). Command is skipped if disk is too full.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="Optional" type="YesNoType" use="optional">
            <xs:annotation><xs:documentation>If yes, failure of this command does not abort the archive or overall execution.</xs:documentation></xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="ArchiveType">
        <xs:sequence>
            <xs:element name="Restrictions" type="ArchiveRestrictionType" minOccurs="0" />
            <xs:element name="Command" type="ArchiveCommandType" minOccurs="0" maxOccurs="unbounded" />
        </xs:sequence>
        <xs:attribute name="Name" type="xs:string" use="required">
            <xs:annotation><xs:documentation>Unique name for this archive, used in output file naming patterns.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="Keyword" type="xs:string" use="required">
            <xs:annotation><xs:documentation>Output file name pattern for this archive. Supports substitution variables like {SystemType}, {FullComputerName}, {TimeStamp}.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="Concurrency" type="xs:positiveInteger" use="required">
            <xs:annotation><xs:documentation>Maximum number of commands that may run simultaneously within this archive.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="Optional" type="YesNoType" use="optional">
            <xs:annotation><xs:documentation>If yes, failure of this archive does not abort the overall DFIR-ORC execution.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="Repeat" type="ArchiveRepeatType" use="required">
            <xs:annotation><xs:documentation>Archive creation policy if the output file already exists: createnew, overwrite, or once (skip if already present).</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="Compression" type="CompressionType" use="optional">
            <xs:annotation><xs:documentation>Default compression level for this archive: none, fastest, fast, normal, maximum, or ultra.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="command_timeout" type="xs:nonNegativeInteger" use="optional">
            <xs:annotation><xs:documentation>Time in minutes to wait for all commands in this archive to complete before forcing termination (default: 3 hours).</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="archive_timeout" type="xs:nonNegativeInteger" use="optional">
            <xs:annotation><xs:documentation>Time in minutes to wait for archive finalization after commands finish (default: 5 minutes).</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="PhysicalMemory" type="ByteQuantityComparisonType" use="optional">
            <xs:annotation><xs:documentation>Physical memory requirement to run this archive (e.g. gt4GB). Archive is skipped if the condition is not met.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="DiskFree" type="ByteQuantityType" use="optional">
            <xs:annotation><xs:documentation>Minimum free disk space required to run this archive (e.g. 1GB).</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="ChildDebug" type="YesNoType" use="optional">
            <xs:annotation><xs:documentation>If yes, attaches as a debugger to all child processes to capture memory dumps on unhandled exceptions.</xs:documentation></xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:attributeGroup name="MaxLimitsGroupType">
        <xs:attribute name="MaxPerSamplebytes" type="ByteQuantityType" use="optional">
            <xs:annotation><xs:documentation>Maximum size of a single collected sample file (e.g. 50MB). Samples exceeding this limit are not collected.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="MaxTotalBytes" type="ByteQuantityType" use="optional">
            <xs:annotation><xs:documentation>Maximum total size of all collected samples combined (e.g. 1024MB). Collection stops once this limit is reached.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="MaxSampleCount" type="xs:nonNegativeInteger" use="optional">
            <xs:annotation><xs:documentation>Maximum number of individual samples to collect. Collection stops once this count is reached.</xs:documentation></xs:annotation>
        </xs:attribute>
    </xs:attributeGroup>

    <xs:complexType name="SampleType">
        <xs:annotation><xs:documentation>A named collection group with its own ntfs_find criteria and optional per-sample limits. Collected files are grouped under this sample's name in the output archive.</xs:documentation></xs:annotation>
        <xs:sequence>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element name="ntfs_find" type="NtfsFindType" />
                <xs:element name="ntfs_exclude" type="NtfsExcludeType" />
            </xs:choice>
        </xs:sequence>
        <xs:attribute name="Name" type="xs:string">
            <xs:annotation><xs:documentation>Identifier for this sample group. Collected files are placed in a folder with this name inside the output archive.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="Content" type="SampleContentType" use="optional">
            <xs:annotation><xs:documentation>Data retrieval mode for matched NTFS attributes: data (default $DATA stream), raw (raw attribute bytes), or strings (extracted printable strings with optional min/max length).</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attributeGroup ref="MaxLimitsGroupType" />
    </xs:complexType>

    <xs:simpleType name="SampleNameFormatType">
        <xs:restriction base="xs:string">
            <xs:pattern value="(default|qualifierthenfrn)" />
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="GetThisSamplesType">
        <xs:annotation><xs:documentation>Top-level collection container with global size and count limits. At least one limit must be set, or NoLimits must be specified on the parent element.</xs:documentation></xs:annotation>
        <xs:sequence>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element name="ntfs_find" type="NtfsFindType" />
                <xs:element name="ntfs_exclude" type="NtfsExcludeType" />
                <xs:element name="yara" type="YaraType" minOccurs="0" maxOccurs="unbounded" />
            </xs:choice>
            <xs:element name="Sample" type="SampleType" minOccurs="0" maxOccurs="unbounded" />
        </xs:sequence>
        <xs:attributeGroup ref="MaxLimitsGroupType" />
        <xs:attribute name="Content" type="SampleContentType" use="optional">
            <xs:annotation><xs:documentation>Default data retrieval mode applied to all samples unless overridden: data, raw, or strings.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="samplenameformat" type="SampleNameFormatType" use="optional">
            <xs:annotation><xs:documentation>Naming scheme for collected output files: default (FRN-prefixed) or qualifierthenfrn (qualifier-first naming).</xs:documentation></xs:annotation>
        </xs:attribute>
    </xs:complexType>
</xs:schema>
